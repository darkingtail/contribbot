{
  "name": "contribbot",
  "version": "0.0.0",
  "private": true,
  "description": "Open source collaboration assistant — skills + MCP tools",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter contribbot-mcp dev",
    "test": "pnpm -r test",
    "agent:build": "uv build --project packages/agent",
    "agent:test": "uv run --project packages/agent --group dev pytest",
    "patrol": "uv run --project packages/agent contribbot patrol"
  }
}
