{
  "name": "contribbot-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "contribbot shared domain core boundary",
  "dependencies": {
    "contribbot-platform": "workspace:*",
    "yaml": "^2.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^25.3.0"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "contribbot-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./execution/contracts": {
      "types": "./src/execution/contracts.ts",
      "contribbot-source": "./src/execution/contracts.ts",
      "default": "./dist/execution/contracts.js"
    },
    "./execution/workflow": {
      "types": "./src/execution/workflow.ts",
      "contribbot-source": "./src/execution/workflow.ts",
      "default": "./dist/execution/workflow.js"
    },
    "./repository/ref": {
      "types": "./src/repository/ref.ts",
      "contribbot-source": "./src/repository/ref.ts",
      "default": "./dist/repository/ref.js"
    },
    "./repository/config": {
      "types": "./src/repository/config.ts",
      "contribbot-source": "./src/repository/config.ts",
      "default": "./dist/repository/config.js"
    },
    "./repository/projects": {
      "types": "./src/repository/projects.ts",
      "contribbot-source": "./src/repository/projects.ts",
      "default": "./dist/repository/projects.js"
    },
    "./storage/paths": {
      "types": "./src/storage/paths.ts",
      "contribbot-source": "./src/storage/paths.ts",
      "default": "./dist/storage/paths.js"
    },
    "./todo/file-read": {
      "types": "./src/todo/file-read.ts",
      "contribbot-source": "./src/todo/file-read.ts",
      "default": "./dist/todo/file-read.js"
    },
    "./todo/records": {
      "types": "./src/todo/records.ts",
      "contribbot-source": "./src/todo/records.ts",
      "default": "./dist/todo/records.js"
    },
    "./todo/enums": {
      "types": "./src/todo/enums.ts",
      "contribbot-source": "./src/todo/enums.ts",
      "default": "./dist/todo/enums.js"
    },
    "./todo/pulls": {
      "types": "./src/todo/pulls.ts",
      "contribbot-source": "./src/todo/pulls.ts",
      "default": "./dist/todo/pulls.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/compile-package.mjs --package core --mode build",
    "typecheck": "node ../../scripts/compile-package.mjs --package core --mode typecheck",
    "test": "pnpm build && node --test test/*.test.mjs"
  }
}
